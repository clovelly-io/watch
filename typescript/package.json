{
  "name": "@clovelly/watch",
  "version": "0.1.0",
  "description": "Clovelly Watch for Node: one import sends the telemetry Watch's monitors need, with payloads sealed to your key.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./register": {
      "types": "./dist/src/register.d.ts",
      "default": "./dist/src/register.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p .",
    "lint": "tsc -p . --noEmit",
    "pretest": "tsc -p .",
    "test": "node --test dist/test/*.test.js",
    "licences": "node scripts/check-licences.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/instrumentation": "0.301.1",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/otlp-transformer": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
